# PageDock Environment Configuration
# Copy this to .env and populate with your credentials

# Application
APP_NAME=PageDock
APP_ENV=production
APP_URL=https://your-domain.infinityfreeapp.com

# Deployment: InfinityFree FTP Credentials
FTP_HOST=ftpupload.net
FTP_PORT=21
FTP_USER=epiz_xxxxxxxx
FTP_PASS=your_ftp_password_here
FTP_ROOT=/htdocs
FTP_SSL=false

# Database Configuration (supports sqlite or mysql)
# For local development: sqlite
# For InfinityFree cPanel: mysql
DB_DRIVER=sqlite
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_NAME=epiz_xxxxxxxx_pagedock
DB_USER=epiz_xxxxxxxx
DB_PASS=your_mysql_password_here

